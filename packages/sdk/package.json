{
  "name": "atlas-ai-sdk",
  "version": "0.2.0",
  "description": "Privacy-safe lifecycle telemetry for AI agent runtimes.",
  "keywords": [
    "ai-agent",
    "codex",
    "claude-code",
    "telemetry",
    "agent-status"
  ],
  "homepage": "https://github.com/LLHOYH/Atlas#readme",
  "bugs": {
    "url": "https://github.com/LLHOYH/Atlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLHOYH/Atlas.git",
    "directory": "packages/sdk"
  },
  "author": "LLHOYH",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atlas": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "import": "./dist/device.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  }
}
